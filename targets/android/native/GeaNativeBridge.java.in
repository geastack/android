package @PACKAGE@;

import android.content.Context;
import android.net.ConnectivityManager;
import android.net.Network;
import android.net.NetworkCapabilities;
import android.net.NetworkInfo;
import android.os.Build;
import java.io.ByteArrayOutputStream;
import java.io.InputStream;
import java.net.HttpURLConnection;
import java.net.URL;
import java.nio.charset.StandardCharsets;
import java.util.List;
import java.util.Locale;
import java.util.Map;

final class GeaNativeBridge {
  private static final int FETCH_LIMIT_BYTES = 2 * 1024 * 1024;
  private static volatile Context applicationContext;

  static {
    System.loadLibrary("gea_android");
  }

  private GeaNativeBridge() {}

  static native void nativeInit(int width, int height, float devicePixelRatio);
  static native int[] nativeFrame(int width, int height, float devicePixelRatio, long frameTimeNanos);
  static native boolean nativeHasMountedRoot(int width, int height, float devicePixelRatio);
  static native int[] nativeDrawFrame(android.graphics.Canvas canvas, int width, int height, float devicePixelRatio, long frameTimeNanos);
  static native boolean nativeDidDrawNativeCanvas();
  static native int nativeCanvasPixels(int[] target);
  static native void nativeSetSurface(android.view.Surface surface);
  static native boolean nativeBlitToSurface();
  static native String[] nativeTexts();
  static native int[] nativeImagePixels(int imageId);
  static native boolean nativeNeedsFrame();
  static native void nativeClick(int nodeId);
  static native void nativeTap(int x, int y);
  static native boolean nativeTouch(int phase, boolean touching, int x, int y, int pointerId);
  static native boolean nativeScrollBy(int nodeId, int dx, int dy);
  static native String nativeAttribute(int nodeId, String name);
  static native boolean nativeInput(int nodeId, String value);
  static native boolean nativeKeyDown(int nodeId, int keyCode);
  static native void nativeFocusInput(int nodeId, boolean focused);
  static native String nativeRenderer();

  static void setApplicationContext(Context context) {
    applicationContext = context != null ? context.getApplicationContext() : null;
  }

  static boolean networkConnectedForNative() {
    Context context = applicationContext;
    if (context == null) return true;
    ConnectivityManager manager = (ConnectivityManager) context.getSystemService(Context.CONNECTIVITY_SERVICE);
    if (manager == null) return true;
    if (Build.VERSION.SDK_INT >= 23) {
      Network network = manager.getActiveNetwork();
      if (network == null) return false;
      NetworkCapabilities capabilities = manager.getNetworkCapabilities(network);
      return capabilities != null && capabilities.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET);
    }
    NetworkInfo info = manager.getActiveNetworkInfo();
    return info != null && info.isConnected();
  }

  static byte[] fetchUrlForNative(final String url) {
    final byte[][] result = new byte[1][];
    Thread worker = new Thread(new Runnable() {
      @Override
      public void run() {
        result[0] = fetchUrlOnWorker(url);
      }
    }, "gea-fetch");
    worker.setDaemon(true);
    worker.start();
    try {
      worker.join(35000);
    } catch (InterruptedException interrupted) {
      Thread.currentThread().interrupt();
      return packFetch(0, "Interrupted", "", new byte[0]);
    }
    if (worker.isAlive()) {
      worker.interrupt();
      return packFetch(0, "Timeout", "", new byte[0]);
    }
    return result[0] != null ? result[0] : packFetch(0, "No response", "", new byte[0]);
  }

  private static byte[] fetchUrlOnWorker(String urlText) {
    HttpURLConnection connection = null;
    try {
      URL url = new URL(urlText);
      connection = (HttpURLConnection) url.openConnection();
      connection.setConnectTimeout(30000);
      connection.setReadTimeout(30000);
      connection.setInstanceFollowRedirects(true);
      connection.setRequestProperty("User-Agent", "gea-android/1.0");

      int status = connection.getResponseCode();
      String statusText = connection.getResponseMessage();
      if (statusText == null) statusText = "";
      InputStream input = status >= 400 ? connection.getErrorStream() : connection.getInputStream();
      byte[] body = readLimited(input);
      String headers = responseHeaders(connection);
      return packFetch(status, statusText, headers, body);
    } catch (Throwable error) {
      String message = error.getMessage();
      if (message == null || message.length() == 0) message = error.getClass().getSimpleName();
      return packFetch(0, message, "", new byte[0]);
    } finally {
      if (connection != null) connection.disconnect();
    }
  }

  private static String responseHeaders(HttpURLConnection connection) {
    StringBuilder out = new StringBuilder();
    Map<String, List<String>> headers = connection.getHeaderFields();
    if (headers == null) return "";
    for (Map.Entry<String, List<String>> entry : headers.entrySet()) {
      String name = entry.getKey();
      List<String> values = entry.getValue();
      if (name == null || values == null || values.isEmpty()) continue;
      out.append(name.toLowerCase(Locale.US)).append(": ");
      for (int i = 0; i < values.size(); i++) {
        if (i > 0) out.append(", ");
        out.append(values.get(i));
      }
      out.append('\n');
    }
    return out.toString();
  }

  private static byte[] readLimited(InputStream input) throws java.io.IOException {
    if (input == null) return new byte[0];
    try {
      ByteArrayOutputStream out = new ByteArrayOutputStream();
      byte[] buffer = new byte[8192];
      int total = 0;
      for (;;) {
        int room = FETCH_LIMIT_BYTES - total;
        if (room <= 0) break;
        int read = input.read(buffer, 0, Math.min(buffer.length, room));
        if (read < 0) break;
        if (read == 0) continue;
        out.write(buffer, 0, read);
        total += read;
      }
      return out.toByteArray();
    } finally {
      input.close();
    }
  }

  private static byte[] packFetch(int status, String statusText, String responseHeaders, byte[] body) {
    if (statusText == null) statusText = "";
    if (responseHeaders == null) responseHeaders = "";
    if (body == null) body = new byte[0];
    byte[] header = (status + "\n" + statusText + "\n" + responseHeaders).getBytes(StandardCharsets.UTF_8);
    byte[] packed = new byte[8 + header.length + body.length];
    writeInt32LE(packed, 0, header.length);
    writeInt32LE(packed, 4, body.length);
    System.arraycopy(header, 0, packed, 8, header.length);
    System.arraycopy(body, 0, packed, 8 + header.length, body.length);
    return packed;
  }

  private static void writeInt32LE(byte[] out, int offset, int value) {
    out[offset] = (byte) (value & 0xff);
    out[offset + 1] = (byte) ((value >> 8) & 0xff);
    out[offset + 2] = (byte) ((value >> 16) & 0xff);
    out[offset + 3] = (byte) ((value >> 24) & 0xff);
  }

  static void playTone(int type, double frequencyHz, int durationMs, int delayMs, int volumePercent) {
    GeaNativeAudio.playTone(type, frequencyHz, durationMs, delayMs, volumePercent);
  }
}
